# Sumont Bela Vista — configuração para a Hostinger (LiteSpeed/Apache)

# 1) Sempre HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Tipos de arquivo (garante que WebP e MP4 sejam servidos corretamente)
AddType image/webp .webp
AddType video/mp4 .mp4
AddType image/svg+xml .svg

# 3) Compressão de texto (HTML, CSS, JS, SVG)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# 4) Cache no navegador
#    Imagens e vídeos: 1 mês. CSS e JS: 1 semana (se mudar algo, o visitante recebe em até 7 dias;
#    para forçar antes, renomeie o arquivo ou acrescente ?v=2 no link). HTML: sempre atualizado.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 5) Segurança básica
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
Options -Indexes
